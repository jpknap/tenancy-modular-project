								"type": "text/javascript",
								"exec": [
									"pm.test('ok', () => pm.response.to.have.status(200));",
									"pm.test('note actualizada', () => pm.expect(pm.response.json().note).to.eql('actualizado desde Postman'));"
								]
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"actualizado desde Postman\"\n}"
